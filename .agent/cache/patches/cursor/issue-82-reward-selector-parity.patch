index 000000000..187495550
--- /dev/null
+++ b/logic/test/unit/policies/test_reward_profit_parity.py
@@ -0,0 +1,91 @@
+"""M-cursor-02: lock the three profit formulas and the conversion between them.
+
+Training ``VRPP.get_costs``, the simulator ``Bins.collect`` profit, and the
+classical-solver ``revenue_scaled`` helper use three unit systems. Merging
+them would rescale RL rewards and crosses other lanes' files; this test
+records the identities so a later merge cannot drift silently.
+"""
+
+import pytest
+import torch
+from logic.src.constants.tasks import COST_KM, REVENUE_KG
+from logic.src.envs.tasks.vrpp import VRPP
+from logic.src.pipeline.simulations.repository.base import SimulationRepository
+
+pytestmark = [pytest.mark.unit, pytest.mark.fast]
+
+# Plastic / Rio Maior, matching the paper's archived logs.
+_PLASTIC_R = 0.65 * 898 / 1000  # 0.5837 €/kg
+_C = 1.0  # €/km
+_VOLUME = 2.5
+_DENSITY = 19.0
+_CAP_KG = _VOLUME * _DENSITY  # 47.5 kg at 100 % fill
+
+
+def _sim_profit(fill_percent, km, revenue_kg=_PLASTIC_R, volume=_VOLUME, density=_DENSITY, cost_km=_C):
+    kg = (fill_percent / 100.0) * volume * density
+    return kg * revenue_kg - km * cost_km
+
+
+def _policy_scaled_profit(fill_percent, km, revenue_kg=_PLASTIC_R, volume=_VOLUME, density=_DENSITY, cost_km=_C):
+    # base_routing_policy: R_scaled = revenue_kg * density * volume / 100  (€ per 1 % fill)
+    revenue_scaled = revenue_kg * (density * volume / 100.0)
+    return fill_percent * revenue_scaled - km * cost_km
+
+
+def test_area_params_match_the_paper_plastic_coefficients():
+    _q, revenue, density, expenses, volume = SimulationRepository.get_area_params("riomaior", "plastic")
+    assert revenue == pytest.approx(_PLASTIC_R)
+    assert density == pytest.approx(_DENSITY)
+    assert expenses == pytest.approx(_C)
+    assert volume == pytest.approx(_VOLUME)
+
+
+def test_simulator_and_policy_scaled_profit_agree():
+    """The 190 kg / 96.167 km archived day: profit = 14.736."""
+    fill_percent = 190.0 / _CAP_KG * 100.0  # mass as equivalent fill of one 47.5 kg bin
+    km = 96.167
+    sim = _sim_profit(fill_percent, km)
+    scaled = _policy_scaled_profit(fill_percent, km)
+    assert sim == pytest.approx(0.5837 * 190.0 - 96.167, abs=1e-3)
+    assert sim == pytest.approx(14.736, abs=1e-3)
+    assert scaled == pytest.approx(sim)
+
+
+def test_training_get_costs_is_the_legacy_unit_proxy():
+    """VRPP.get_costs uses COST_KM=REVENUE_KG=1.0 on fraction waste, not €/kg."""
+    assert COST_KM == 1.0
+    assert REVENUE_KG == 1.0
+    dataset = {
+        "depot": torch.tensor([[0.0, 0.0]]),
+        "loc": torch.tensor([[[1.0, 0.0]]]),
+        "waste": torch.tensor([[1.0]]),  # full bin as a fraction (typical training)
+        "cost_km": COST_KM,
+        "revenue_kg": REVENUE_KG,
+    }
+    pi = torch.tensor([[0, 1, 0]])
+    neg_profit, cost_dict, _ = VRPP.get_costs(dataset, pi, cw_dict=None)
+    # Euclidean length 2.0; waste 1.0 → neg_profit = 2*1 - 1*1 = 1.0
+    assert cost_dict["waste"].item() == pytest.approx(1.0)
+    assert cost_dict["length"].item() == pytest.approx(2.0)
+    assert neg_profit.item() == pytest.approx(1.0)
+
+
+def test_training_proxy_does_not_equal_simulator_profit_on_the_same_numbers():
+    """Same 1.0 fraction-full bin, 2 km: sim uses R=0.5837 and 47.5 kg, training does not."""
+    km = 2.0
+    waste_frac = 1.0
+    training_neg = km * COST_KM - waste_frac * REVENUE_KG
+    sim = _sim_profit(100.0, km)
+    assert training_neg == pytest.approx(1.0)
+    assert sim == pytest.approx(_CAP_KG * _PLASTIC_R - km * _C)
+    assert abs(sim - (-training_neg)) > 1.0  # magnitudes are not interchangeable
+
+
+def test_conversion_identity_from_fraction_waste_to_sim_profit():
+    """kg = waste_frac * volume * density recovers the simulator formula."""
+    waste_frac = 0.80
+    km = 10.0
+    kg = waste_frac * _VOLUME * _DENSITY
+    converted = kg * _PLASTIC_R - km * _C
+    assert converted == pytest.approx(_sim_profit(80.0, km))
