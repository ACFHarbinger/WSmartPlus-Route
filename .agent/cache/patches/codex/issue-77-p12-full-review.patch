+++ b/Evidence/check_example.py
@@ -0,0 +1,85 @@
+"""Exhaustive four-bin verification, integer metres/grams-of-euro; no simulator.
+Run with Python 3.9+. Every ordered route and every disjoint pair is considered.
+Route reversal ties are collapsed; uniqueness refers to visit-set trajectories.
+"""
+from itertools import combinations, permutations
+from functools import lru_cache
+import json
+
+INITIAL = (150, 60, 200, 90)
+ARRIVAL = (60, 20, 70, 25)
+D = ((0,22,32,91,98),(22,0,22,70,77),(32,22,0,63,100),
+     (91,70,63,0,22),(98,77,100,22,0))  # tenths of km
+
+@lru_cache(None)
+def routes(post):
+    options = [(0, 0, 0)]
+    for size in range(1, 5):
+        for bins in combinations(range(4), size):
+            if sum(post[i] for i in bins) > 600:
+                continue
+            mask = sum(1 << i for i in bins)
+            distance = min(sum(D[a][b] for a,b in zip((0,)+p,p+(0,)))
+                           for p in permutations(tuple(i+1 for i in bins)))
+            options.append((mask, distance, 1))
+    plans = {}
+    for a in options:
+        for b in options:
+            if a[0] & b[0]:
+                continue
+            mask, distance, vehicles = a[0] | b[0], a[1]+b[1], a[2]+b[2]
+            cost = 1000*distance + 1000*vehicles  # 1/10000 euro
+            if mask not in plans or cost < plans[mask][0]:
+                plans[mask] = (cost, distance, vehicles)
+    return plans
+
+def actions(state):
+    post = tuple(a+b for a,b in zip(state, ARRIVAL))
+    forced = sum(1 << i for i in range(4) if post[i] > 300)
+    for mask, (cost, distance, vehicles) in routes(post).items():
+        if mask & forced != forced:
+            continue
+        mass = sum(post[i] for i in range(4) if mask & (1 << i))
+        closing = tuple(0 if mask & (1 << i) else post[i] for i in range(4))
+        yield closing, dict(visits=[i+1 for i in range(4) if mask & (1 << i)],
+            mass=mass, km=distance/10, vehicles=vehicles,
+            profit_units=952*mass-cost, overflow=sum(v >= 300 for v in post))
+
+def enumerate_paths(state=INITIAL, path=()):
+    if len(path) == 3:
+        yield state, path
+    else:
+        for closing, action in actions(state):
+            yield from enumerate_paths(closing, path+(action,))
+
+def evaluate(state, path, residual):
+    return sum(a['profit_units'] for a in path) + residual*sum(state)
+
+def summary(state, path):
+    return dict(terminal_mass=sum(state), kg=sum(a['mass'] for a in path),
+        km=round(sum(a['km'] for a in path),1),
+        profit=evaluate(state,path,0)/10000,
+        objective_r=evaluate(state,path,952)/10000,
+        vehicles=sum(a['vehicles'] for a in path),
+        overflows=sum(a['overflow'] for a in path),path=path)
+
+if __name__ == '__main__':
+    all_paths = list(enumerate_paths())
+    result = {'trajectories':len(all_paths)}
+    for residual in (0,952):
+        best = max(evaluate(s,p,residual) for s,p in all_paths)
+        optima = [(s,p) for s,p in all_paths if evaluate(s,p,residual)==best]
+        result['rho_0' if residual == 0 else 'rho_R'] = dict(
+            value=best/10000, count=len(optima), examples=[summary(s,p) for s,p in optima[:2]])
+    state, path = INITIAL, ()
+    for _ in range(3):
+        state, action = max(actions(state),key=lambda a:a[1]['profit_units'])
+        path += (action,)
+    result['myopic'] = summary(state,path)
+    assert result['trajectories']==2688
+    assert result['rho_0']['value']==60.532
+    assert result['myopic']['profit']==45.28
+    assert result['rho_R']['value']==79.18
+    assert result['rho_R']['count']==1
+    assert result['rho_0']['examples'][0]['objective_r']==71.48
+    print(json.dumps(result,indent=2))
