+"""Algebraic boundary witnesses for P12; no solver or simulator required."""
+# One bin, one route 0->1->2, Q=100, q=20.
+Q, q, k = 100, 20, 1
+f = {(0,1):0, (1,2):q}
+h = {(0,1):Q, (1,2):Q-q}
+assert f[1,2]-f[0,1] == q
+assert h[0,1]-h[1,2] == q
+assert all(f[edge]+h[edge] == Q for edge in f)
+assert h.get((2,1),0) != Q*k-q  # original reversed residual depot equation
+assert h.get((1,0),0) != Q*k
+assert h[1,2] == Q*k-q and h[0,1] == Q*k
+# A zero-demand disconnected 1->2->1 cycle satisfies degrees/coupling/flows.
+cycle=((1,2),(2,1))
+assert len(cycle)==2  # violates internal-arc cut <= |{1,2}|-1 = 1
+# Original initial-state assumption admits w=U, then arrival exceeds U.
+psi, capacity, arrival, opening = 1, 100, 10, 110
+old_bound=psi*capacity+arrival
+assert opening <= old_bound and opening+arrival > old_bound
+new_bound=max(opening+arrival, psi*capacity+arrival)
+assert opening+arrival <= new_bound
+# Distinguish strict force threshold from inclusive overflow reporting.
+post=capacity
+assert post >= capacity  # overflow=1
+assert post-psi*capacity <= new_bound*0  # g=0 remains feasible
+print('PASS: depot directions, zero-demand cycle, initial bound, threshold equality')
