-        return np.array(
-            [
-                float(self.state.best_improved),
-                float(self.state.current_accepted),
-                float(self.state.current_improved),
-                float(self.state.is_current_best),
-                self.state.cost_diff_best,
-                float(self.state.stagnation_count),
-                self.state.search_budget,
-            ],
-            dtype=np.float32,
-        )
-
-    def _apply_operators(
-        self,
-        routes: List[List[int]],
-        destroy_idx: int,
-        repair_idx: int,
-        severity: float,
-    ) -> List[List[int]]:
-        """Apply selected destroy and repair operators.
-
-        Args:
-            routes: List of routes to apply operators to
-            destroy_idx: Index of destroy operator to use
-            repair_idx: Index of repair operator to use
-            severity: Severity of destroy operator (0-1)
-
-        Returns:
-            List of routes after applying operators
