-            d = self.split_manager.dist_matrix[0, r[0]]
-            rev += self.split_manager.wastes[r[0]] * self.split_manager.R
-            for i in range(len(r) - 1):
-                d += self.split_manager.dist_matrix[r[i], r[i + 1]]
