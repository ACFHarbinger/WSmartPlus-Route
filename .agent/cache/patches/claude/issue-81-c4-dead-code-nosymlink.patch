-def _fix_stripped_decimal(val: float, lo: float, hi: float) -> float:
-    """Recover a decimal point dropped during export (e.g. 401484222222222 -> 40.1484222222222)."""
-    lo, hi = sorted([abs(lo), abs(hi)])
-    s = abs(val)
-    if lo <= s <= hi:
-        return val
-    for k in range(1, 18):
-        cand = s / (10**k)
-        if lo <= cand <= hi:
-            return math.copysign(cand, val)
-    return val
-
