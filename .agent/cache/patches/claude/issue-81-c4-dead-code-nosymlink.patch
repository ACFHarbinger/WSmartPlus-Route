-        for ci in range(n_cols):
-            xs, ys = x0 + ci * cell_w, y0 + ri * cell_h
-            ax.add_patch(mpatches.Rectangle((xs, ys), cell_w, cell_h, fill=False, edgecolor="#CCCCCC", linewidth=0.4))
