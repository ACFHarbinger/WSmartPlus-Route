-def pareto_indices(xs, ys) -> set[int]:
-    """Positional indices of non-dominated points (min x=overflows, max y=kgkm)."""
-    order = sorted(range(len(xs)), key=lambda i: (xs[i], -ys[i]))
-    front, best = set(), -np.inf
-    for i in order:
-        if ys[i] > best:
-            front.add(i)
-            best = ys[i]
-    return front
