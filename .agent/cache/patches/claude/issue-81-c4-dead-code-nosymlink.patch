-            ax.text(
-                x_left + lw / 2, (ys + ye) / 2, str(label),
-                ha="center", va="center", fontsize=lvl_fontsize, color="#1F2D3D", fontweight="bold",
-            )
-            # Separator across the data area (not the row-label area) at every
