+"""
+PG-CLNS operator parity tests.
+
+These tests verify that the shared operators (now used by PG-CLNS) produce
+the expected behavior based on the documented old PG-CLNS operator behavior.
+
+Since the old PG-CLNS operators have been deleted, these tests reconstruct
+the old behavior and verify the shared operators match it (for operators
+that should stay identical) or produce the expected different behavior
+(for operators that changed).
+"""
+
+import random
+from typing import Dict, List
+
+import numpy as np
+import pytest
+
+from logic.src.policies.helpers.operators.destroy_ruin.cluster import cluster_removal
+from logic.src.policies.helpers.operators.destroy_ruin.random import random_removal
+from logic.src.policies.helpers.operators.destroy_ruin.worst import worst_removal
+from logic.src.policies.helpers.operators.recreate_repair.greedy import (
+    greedy_profit_insertion,
+)
+from logic.src.policies.helpers.operators.recreate_repair.regret import (
+    regret_2_profit_insertion,
+)
+
+
+def old_pg_clns_random_removal(
+    routes: List[List[int]], n_remove: int, rng: random.Random
+) -> tuple:
+    """
+    Reconstruct the old PG-CLNS random_removal behavior.
+
+    Old behavior: index-based popping with targets sorted by descending index.
+    """
+    removed = []
+    all_nodes = [(r_idx, n_idx, node) for r_idx, route in enumerate(routes) for n_idx, node in enumerate(route)]
+
+    if len(all_nodes) <= n_remove:
+        for r_idx, n_idx, node in all_nodes:
+            removed.append(node)
+        return [[] for _ in routes], removed
+
+    targets = rng.sample(all_nodes, n_remove)
+    targets.sort(key=lambda x: (x[0], x[1]), reverse=True)
+
+    for r_idx, n_idx, node in targets:
+        routes[r_idx].pop(n_idx)
+        removed.append(node)
+
+    return routes, removed
+
+
+def old_pg_clns_worst_removal(
+    routes: List[List[int]], n_remove: int, dist_matrix: np.ndarray
+) -> tuple:
+    """
+    Reconstruct the old PG-CLNS worst_removal behavior.
+
+    Old behavior: deterministic sort by detour saving, take top n_remove.
+    """
+    nodes_with_savings = []
+    for r_idx, route in enumerate(routes):
+        for n_idx in range(len(route)):
+            node = route[n_idx]
+            prev_node = route[n_idx - 1] if n_idx > 0 else 0
+            next_node = route[n_idx + 1] if n_idx < len(route) - 1 else 0
+
+            detour = dist_matrix[prev_node][node] + dist_matrix[node][next_node] - dist_matrix[prev_node][next_node]
+            nodes_with_savings.append((detour, r_idx, n_idx, node))
+
+    nodes_with_savings.sort(reverse=True)
+    removed = []
+    for detour, r_idx, n_idx, node in nodes_with_savings[:n_remove]:
+        routes[r_idx].pop(n_idx)
+        removed.append(node)
+
+    return routes, removed
+
+
+@pytest.fixture
+def simple_dist_matrix():
+    """4-node problem: depot (0) + 3 customers."""
+    return np.array([
+        [0.0, 10.0, 20.0, 30.0],
+        [10.0, 0.0, 15.0, 25.0],
+        [20.0, 15.0, 0.0, 10.0],
+        [30.0, 25.0, 10.0, 0.0],
+    ])
+
+
+@pytest.fixture
+def wastes() -> Dict[int, float]:
+    return {1: 5.0, 2: 8.0, 3: 3.0}
+
+
+class TestRandomRemovalParity:
+    """Verify shared random_removal matches old PG-CLNS behavior."""
+
+    def test_parity_with_old_behavior(self, simple_dist_matrix):
+        """Shared version should produce same output as old version with same seed."""
+        routes = [[1, 2], [3]]
+        n_remove = 2
+        seed = 42
+
+        # Old behavior
+        routes_old = [r.copy() for r in routes]
+        rng_old = random.Random(seed)
+        result_old, removed_old = old_pg_clns_random_removal(routes_old, n_remove, rng_old)
+
+        # New behavior (shared operator)
+        routes_new = [r.copy() for r in routes]
+        rng_new = random.Random(seed)
+        result_new, removed_new = random_removal(routes_new, n_remove, rng=rng_new)
+
+        # Should remove the same nodes (order may differ due to implementation)
+        assert sorted(removed_old) == sorted(removed_new)
+
+
+class TestWorstRemovalBehaviorChange:
+    """Verify shared worst_removal with p=3.0 differs from old deterministic behavior."""
+
+    def test_old_behavior_was_deterministic(self, simple_dist_matrix):
+        """Old behavior: same seed → same result."""
+        routes = [[1, 2, 3]]
+        n_remove = 2
+
+        routes1 = [r.copy() for r in routes]
+        result1, removed1 = old_pg_clns_worst_removal(routes1, n_remove, simple_dist_matrix)
+
+        routes2 = [r.copy() for r in routes]
+        result2, removed2 = old_pg_clns_worst_removal(routes2, n_remove, simple_dist_matrix)
+
+        assert removed1 == removed2
+
+    def test_new_behavior_is_randomized(self, simple_dist_matrix):
+        """New behavior with p=3.0: different seeds → different results."""
+        routes = [[1, 2, 3]]
+        n_remove = 2
+
+        results = set()
+        for seed in range(10):
+            routes_copy = [r.copy() for r in routes]
+            rng = np.random.default_rng(seed)
+            _, removed = worst_removal(routes_copy, n_remove, simple_dist_matrix, p=3.0, rng=rng)
+            results.add(tuple(sorted(removed)))
+
+        # With p=3.0, should see at least 2 different removal patterns
+        assert len(results) >= 2
+
+
+class TestCapacityCheckParity:
+    """Verify shared repair operators match old PG-CLNS capacity check behavior."""
+
+    def test_old_behavior_rejected_over_capacity(self, simple_dist_matrix):
+        """Old PG-CLNS greedy_insertion rejected nodes with demand > capacity."""
+        routes = [[]]
+        removed_nodes = [1]
+        wastes = {1: 20.0}  # demand=20 > capacity=10
+        capacity = 10.0
+        R = 1.0
+        C = 1.0
+
+        # Old behavior: would reject this node
+        # (reconstructed from documented behavior)
+        # Result is empty list (no routes) since the only route was empty and node was rejected
+        expected_result = []
+
+        # New behavior: should also reject
+        result = greedy_profit_insertion(
+            routes, removed_nodes, simple_dist_matrix, wastes, capacity, R, C
+        )
+
+        assert result == expected_result
+
+    def test_mandatory_node_over_capacity_rejected(self, simple_dist_matrix):
+        """Old PG-CLNS rejected mandatory nodes with demand > capacity."""
+        routes = [[]]
+        removed_nodes = [1]
+        wastes = {1: 20.0}  # demand=20 > capacity=10
+        capacity = 10.0
+        R = 1.0
+        C = 1.0
+        mandatory_nodes = [1]
+
+        # Old behavior: would reject even mandatory node
+        expected_result = []
+
+        # New behavior: should also reject
+        result = greedy_profit_insertion(
+            routes, removed_nodes, simple_dist_matrix, wastes, capacity, R, C,
+            mandatory_nodes=mandatory_nodes
+        )
+
+        assert result == expected_result
+
+
+class TestDirectedDistanceParity:
+    """Verify shared profit insertion uses directed distances correctly."""
+
+    def test_profit_calculation(self, simple_dist_matrix):
+        """Profit = waste * R - distance * C."""
+        routes = [[1]]
+        removed_nodes = [2]
+        wastes = {1: 5.0, 2: 8.0}
+        capacity = 100.0
+        R = 1.0
+        C = 0.1
+
+        result = greedy_profit_insertion(
+            routes, removed_nodes, simple_dist_matrix, wastes, capacity, R, C
+        )
+
+        # Node 2 should be inserted (profitable)
+        all_nodes = [n for r in result for n in r]
+        assert 2 in all_nodes
+
+
+class TestMandatoryNodeParity:
+    """Verify shared operators handle mandatory nodes correctly."""
+
+    def test_mandatory_node_inserted_even_if_unprofitable(self, simple_dist_matrix):
+        """Mandatory nodes should be inserted even with negative profit."""
+        routes = [[]]
+        removed_nodes = [1, 2]
+        wastes = {1: 1.0, 2: 1.0}
+        capacity = 100.0
+        R = 0.01  # very low revenue
+        C = 10.0  # very high cost
+        mandatory_nodes = [1]
+
+        result = greedy_profit_insertion(
+            routes, removed_nodes, simple_dist_matrix, wastes, capacity, R, C,
+            mandatory_nodes=mandatory_nodes
+        )
+
+        # Mandatory node 1 should be inserted
+        all_nodes = [n for r in result for n in r]
+        assert 1 in all_nodes
+
+    def test_optional_node_skipped_if_unprofitable(self, simple_dist_matrix):
+        """Optional nodes with negative profit should be skipped."""
+        routes = [[]]
+        removed_nodes = [1]
+        wastes = {1: 1.0}
+        capacity = 100.0
+        R = 0.01  # very low revenue
+        C = 10.0  # very high cost
+
+        result = greedy_profit_insertion(
+            routes, removed_nodes, simple_dist_matrix, wastes, capacity, R, C
+        )
+
+        # Optional node 1 should NOT be inserted
+        all_nodes = [n for r in result for n in r]
+        assert 1 not in all_nodes
