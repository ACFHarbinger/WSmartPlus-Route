 #!/usr/bin/env python
 """
-Entry Point for Package Execution (Hydra commands only).
+Entry point for the WSmart-Route minimal export (run the package folder).
 
-Routes CLI commands to the Hydra-based configuration system.
-Non-Hydra commands (test_suite, file_system, benchmark) must be
-invoked via ``python main.py <command>`` instead.
+Every command is routed through the Hydra configuration system:
+
+    python . train    [overrides...]
+    python . eval     [overrides...]
+    python . test_sim [overrides...]
 """
 
 import sys
+import typing
 import warnings
 
+# Ensure typing.Self compatibility for Python < 3.11
+if not hasattr(typing, "Self"):
+    try:
+        from typing_extensions import Self
+
+        typing.Self = Self  # type: ignore[attr-defined]
+    except ImportError:
+        typing.Self = typing.Any  # type: ignore[attr-defined]
+
+# Ensure torch.multiprocessing.reductions.ForkingPickler compatibility (Tensordict + Torch 2.11+)
+try:
+    import torch.multiprocessing.reductions
+
+    if not hasattr(torch.multiprocessing.reductions, "ForkingPickler"):
+        import multiprocessing.reduction as reduction
+
+        torch.multiprocessing.reductions.ForkingPickler = reduction.ForkingPickler  # type: ignore[attr-defined]
+except ImportError:
+    pass
+
 from logic.controllers.hydra_dispatch import hydra_entry_point
 
 warnings.filterwarnings(
@@ -18,21 +41,33 @@ warnings.filterwarnings(
     message="jax.tree_util.register_keypaths is deprecated",
 )
 
+_TASK_ALIASES = {"evaluation": "eval"}
+_TASKS = {"train", "eval", "test_sim"}
+
 
 def main() -> None:
-    """Parse the CLI command and dispatch to Hydra."""
-    if len(sys.argv) < 2:
-        print("Usage: python -m WSmart-Route <task> [overrides...]")
-        print("Available tasks: train, evaluation, test_sim, gen_data, hpo, meta_train")
-        print("\nFor non-Hydra commands (test_suite, file_system, etc.), use: python main.py <command>")
-        sys.exit(1)
-
-    raw_task = sys.argv.pop(1)
-    task = {"evaluation": "eval", "sim_hpo": "hpo_sim"}.get(raw_task, raw_task)
-    sys.argv.append(f"tasks={task}")
-    sys.argv.append(f"task={task}")
+    """Translate ``python . <task> ...`` into a Hydra ``tasks=<task>`` override and run it."""
+    if len(sys.argv) < 2 or sys.argv[1] in {"-h", "--help"}:
+        print(__doc__)
+        print("Available tasks:", ", ".join(sorted(_TASKS)))
+        print("Append --help after a task name for the Hydra help of that task.")
+        sys.exit(0)
+
+    first_arg = sys.argv[1]
+    if first_arg in _TASKS or first_arg in _TASK_ALIASES:
+        task = _TASK_ALIASES.get(sys.argv.pop(1), first_arg)
+        sys.argv.append(f"tasks={task}")
+    elif not first_arg.startswith("tasks="):
+        print(f"Unknown task {first_arg!r}. Available tasks: {', '.join(sorted(_TASKS))}")
+        sys.exit(2)
+
     hydra_entry_point()
 
 
 if __name__ == "__main__":
+    # Required for multiprocessing (simulator workers) in a frozen executable;
+    # a no-op when running from source.
+    import multiprocessing
+
+    multiprocessing.freeze_support()
     main()
