// WSmart+ Route — Simulator pipeline flowchart
// Source of truth: logic/src/pipeline/features/test/orchestrator/, logic/src/pipeline/simulations/
// Render: dot -Tpdf simulator_pipeline_flowchart.dot -o simulator_pipeline_flowchart.pdf
digraph SimulatorPipeline {
    graph [rankdir=TB, fontname="Helvetica", fontsize=11, labelloc=t, labeljust=l,
           label=<<B>WSmart+ Route — Multi-day simulator pipeline</B><BR/><FONT POINT-SIZE="9">Entry: main.py test_sim → simulator_testing() → SimulationContext state machine (Initializing → Running → Finishing) → per-day command chain</FONT>>,
           nodesep=0.35, ranksep=0.45, compound=true, newrank=true, splines=spline, pad=0.3];
    node  [fontname="Helvetica", fontsize=9, shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#444444", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=8, color="#555555", arrowsize=0.7];

    // ---- shape conventions -------------------------------------------------
    // terminal    : ellipse, dark fill
    // process     : rounded box
    // decision    : diamond, yellow
    // data / file : cylinder, blue
    // loop bound  : hexagon, orange
    // sub-process : box3d, grey

    start [label="START\npython main.py test_sim <hydra overrides>", shape=ellipse, style="filled", fillcolor="#2F4858", fontcolor="white"];
    end   [label="END\nsummary table · JSON logs · GUI payload", shape=ellipse, style="filled", fillcolor="#2F4858", fontcolor="white"];

    // =====================================================================
    subgraph cluster_orch {
        label=<<B>1. Orchestration</B> — simulator_testing(cfg, data_size, device)>; style="filled,rounded"; fillcolor="#F4F6F8"; color="#9AA5B1";

        cfg [label="Hydra config → Config\nsim.full_policies · graph (area, num_loc, n_days,\nn_samples, waste_type, data_distribution) · seed · cpu_cores", shape=cylinder, fillcolor="#DCEBF7"];
        prune_cfg [label="Expand policy refs & prune config\n(_generate_pruned_config)"];
        samples [label="Build sample index lists\nsample_idx[pol] = [0 .. n_samples-1]"];
        resume_q [label="sim.resume ?", shape=diamond, fillcolor="#FFF3B0"];
        resume_drop [label="Read existing log_<policy>_<N>N.json\ndrop samples already completed"];
        tasks [label="task_count = Σ |sample_idx[pol]|\nn_cores = min(task_count, cpu_cores or cpu_count-1)"];
        focus_q [label="graph.focus_graph ?", shape=diamond, fillcolor="#FFF3B0"];
        idx_load [label="load_indices()\nfixed bin subset per sample", shape=cylinder, fillcolor="#DCEBF7"];
        idx_none [label="indices = None per sample\n(use full graph)"];
        cores_q [label="n_cores > 1 ?", shape=diamond, fillcolor="#FFF3B0"];

        cfg -> prune_cfg -> samples -> resume_q;
        resume_q -> resume_drop [label="yes"];
        resume_q -> tasks [label="no"];
        resume_drop -> tasks -> focus_q;
        focus_q -> idx_load [label="yes"];
        focus_q -> idx_none [label="no"];
        idx_load -> cores_q; idx_none -> cores_q;
    }

    // =====================================================================
    subgraph cluster_par {
        label=<<B>2a. Parallel runner</B> — run_parallel_simulations()>; style="filled,rounded"; fillcolor="#EEF5EE"; color="#7FA87F";
        pool [label="multiprocessing.Pool(n_cores,\ninitializer=init_single_sim_worker)"];
        worker_init [label="Worker init: share Lock / Counter / Manager.dict,\nseed RNGs, init dataset repository,\nattach tracking run, redirect logger"];
        dispatch [label="for each (policy, sample):\npool.apply_async(single_simulation, callback=_update_result)", shape=hexagon, fillcolor="#FFE0B2"];
        collect_par [label="_update_result: store result in shared_metrics,\nrefresh SimulationMonitor display"];
        pool -> worker_init -> dispatch -> collect_par;
    }

    subgraph cluster_seq {
        label=<<B>2b. Sequential runner</B> — sequential_simulations()>; style="filled,rounded"; fillcolor="#EEF5EE"; color="#7FA87F";
        seq_loop [label="for pol_id in policies:\n  for sample_id in sample_idx[pol_id]:", shape=hexagon, fillcolor="#FFE0B2"];
        seq_ctx [label="SimulationContext(cfg, device, indices[sample],\nsample_id, pol_id, weights, {lock, progress, callback}).run()"];
        seq_agg [label="Append result to log_full[policy]\nProgressUpdater.update()"];
        seq_err [label="CheckpointError → skip\nother exception → failed_log (Optuna prune re-raised)", fillcolor="#FDE2E2"];
        seq_loop -> seq_ctx -> seq_agg;
        seq_ctx -> seq_err [style=dashed];
        seq_agg -> seq_loop [style=dashed, label="next"];
    }

    cores_q -> pool [label="yes", lhead=cluster_par];
    cores_q -> seq_loop [label="no", lhead=cluster_seq];

    // =====================================================================
    subgraph cluster_ctx {
        label=<<B>3. One simulation run</B> — SimulationContext.run(): while current_state: state.handle(ctx)>; style="filled,rounded"; fillcolor="#FFF8EC"; color="#D9A441";

        // ---------------- Initializing ----------------
        subgraph cluster_init {
            label=<<B>3.1 InitializingState</B>>; style="filled,rounded"; fillcolor="#FFFDF5"; color="#D9A441";
            seed [label="Seed random / numpy / torch with sim.seed"];
            logdirs [label="Setup results dir\nassets/<output_dir>/<days>days/<area><n>_<waste>/<dist>/<run_name>\nredirect stdout/stderr to log file"];
            loadcfg [label="Load configs: policy YAMLs (policy_cfg), mandatory_selection,\nroute_improvement, policy_neural.yaml"];
            basedata [label="setup_basedata(): bin table, coordinates, depot\nfrom data/simulator/<area>", shape=cylinder, fillcolor="#DCEBF7"];
            caps [label="load_area_and_waste_type_params → vehicle capacity\nload_temporal_params → shift_hours, avg_speed, service_time"];
            ckpt [label="SimulationCheckpoint(results_dir, checkpoint_dir, policy, sample)"];
            ckpt_q [label="sim.resume and\ncheckpoint found ?", shape=diamond, fillcolor="#FFF3B0"];
            models [label="_setup_models(): load neural model + env\n(am / ddam / ptr / transformer) or none for classical policies"];
            restore [label="_restore_state(): new_data, coords, dist_tup,\nbins, model_tup, cached, overflows, daily_log, run_time\nstart_day = last_day + 1"];
            newstate [label="_initialize_new_state():\nprocess_data(indices) → new_data, coords\nsetup_dist_path_tup → (distance_matrix, paths, dm_tensor, distancesC)"];
            bins [label="Bins(n, data_distribution, waste_file …)\ngamma<k> → set_gamma_distribution(k-1)\nset_statistics · set_sample_waste(sample_id) · set_indices"];
            ctop_q [label="problem == ctop\nor tm_filepath ?", shape=diamond, fillcolor="#FFF3B0"];
            tm [label="load_temporal_params(): directed time matrix\n(CTOP shift budget)"];
            to_running [label="transition_to(RunningState)"];

            seed -> logdirs -> loadcfg -> basedata -> caps -> ckpt -> ckpt_q;
            ckpt_q -> models;
            models -> restore [label="resume"];
            models -> newstate [label="fresh"];
            newstate -> bins -> ctop_q;
            restore -> ctop_q;
            ctop_q -> tm [label="yes"];
            ctop_q -> to_running [label="no"];
            tm -> to_running;
        }

        // ---------------- Running ----------------
        subgraph cluster_run {
            label=<<B>3.2 RunningState</B> — checkpoint_manager(ctx.checkpoint, checkpoint_days)>; style="filled,rounded"; fillcolor="#FFFDF5"; color="#D9A441";
            dayloop [label="for day in start_day .. n_days:", shape=hexagon, fillcolor="#FFE0B2"];
            before [label="hook.before_day(day)\nresolve current policy config\n(global mandatory_selection + route_improvement + policy cfg)"];
            daycx [label="Build SimulationDayContext\n(bins, coords, dist matrices, time matrix, n_vehicles,\ncost/waste weights, overflow_penalty, problem, seed …)"];
            rundayref [label="run_day(day_context)\n(see 4. Daily command chain)", shape=box3d, fillcolor="#E8E8E8"];
            after [label="Copy back bins / new_data / overflows / cached\nappend daily_log → cumulative metrics → shared_metrics\nlineage.on_step_end · hook.after_day (checkpoint every checkpoint_days)\nprogress.update · callback(day, metrics, sample)"];
            ckerr [label="CheckpointError\n→ ctx.result = error_result\n→ transition_to(None)", fillcolor="#FDE2E2"];
            to_fin [label="transition_to(FinishingState)"];

            dayloop -> before -> daycx -> rundayref -> after;
            after -> dayloop [style=dashed, label="next day"];
            dayloop -> to_fin [label="done"];
            rundayref -> ckerr [style=dashed, color="#B03A2E"];
        }

        // ---------------- Finishing ----------------
        subgraph cluster_fin {
            label=<<B>3.3 FinishingState</B>>; style="filled,rounded"; fillcolor="#FFFDF5"; color="#D9A441";
            summ [label="sample_metrics = Σ_days daily_log[metric]\n(cost, collected, overflows, lost, reward, kg/km, time_spent …)"];
            wjson [label="log_<policy>_<N>N.json ← sections\n'samples'[sample_id], 'daily'[sample_id]\n(+ 'mean'/'std' when N = 1)", shape=cylinder, fillcolor="#DCEBF7"];
            wxlsx [label="fill_history/<policy><seed>_sample<id>.xlsx\n(bin fill matrix)", shape=cylinder, fillcolor="#DCEBF7"];
            track [label="Tracking: log_artifact(json, xlsx),\nsim_tracker.log_final(SIM_METRICS)"];
            result [label="ctx.result = {policy: metrics, success: True}\ndisplay_per_policy_simulation_summary"];
            summ -> wjson -> wxlsx -> track -> result;
        }

        to_running -> dayloop [lhead=cluster_run];
        to_fin -> summ [lhead=cluster_fin];
    }

    dispatch -> seed [lhead=cluster_ctx, style=dashed, label="each task"];
    seq_ctx -> seed [lhead=cluster_ctx, style=dashed];

    // =====================================================================
    subgraph cluster_day {
        label=<<B>4. Daily command chain</B> — run_day(context): for command in commands: command.execute(context)>; style="filled,rounded"; fillcolor="#F3EEF8"; color="#8E6BB0";

        pseed [label="policy_seed = (seed + adler32(canonical policy name) + day) mod 2³¹\nre-seed random / numpy / torch\nbins.rng = default_rng(policy_seed + day + sample_id)"];

        subgraph cluster_fill {
            label=<<B>FillAction</B>>; style="filled,rounded"; fillcolor="#FBF9FD"; color="#8E6BB0";
            fill [label="bins.load_filling(day)\npre-sampled ground-truth fills (+ noisy sensor fills)\nupdate running mean / std per bin\nclip at 100 % → overflow flags, lost waste"];
            fill_out [label="context: new_overflows, fill,\ntotal_fill, sum_lost; overflows += new", shape=parallelogram, fillcolor="#EDE7F6"];
            fill -> fill_out;
        }

        subgraph cluster_sel {
            label=<<B>MandatorySelectionAction</B>>; style="filled,rounded"; fillcolor="#FBF9FD"; color="#8E6BB0";
            sel_q [label="neural pointer / transformer\npolicy ?", shape=diamond, fillcolor="#FFF3B0"];
            sel_skip [label="skip (model selects nodes itself)"];
            sel_strats [label="for each configured strategy:\nMandatorySelectionFactory.create(name, SelectionContext)\ne.g. last_minute(cf), lookahead, service_level,\nregular / staggered, knapsack, rollout, learned …", shape=hexagon, fillcolor="#FFE0B2"];
            sel_out [label="context: mandatory = list of bin ids\n(union of strategy outputs)", shape=parallelogram, fillcolor="#EDE7F6"];
            sel_q -> sel_skip [label="yes"];
            sel_q -> sel_strats [label="no"];
            sel_strats -> sel_out;
        }

        subgraph cluster_rc {
            label=<<B>RouteConstructionAction</B>>; style="filled,rounded"; fillcolor="#FBF9FD"; color="#8E6BB0";
            rc_key [label="Resolve solver key: policy.type / policy.solver / engine\nor registry match on compound name\n(e.g. lookahead_pg_clns_custom → pg_clns)"];
            rc_q [label="mandatory empty and\nnot vrpp ?", shape=diamond, fillcolor="#FFF3B0"];
            rc_empty [label="tour = [0, 0], cost = 0\n(truck stays at depot)"];
            rc_adapter [label="RouteConstructorFactory.get_adapter(key, config)\n+ MultiDayContext / ScenarioGenerator (if configured)\n+ PolicyVizStreamSession"];
            rc_exec [label="adapter.execute(**context)\nBaseRoutingPolicy: load area params (capacity, R, C)\n→ subset problem (mandatory-only, or full graph if vrpp)\n→ _run_solver (PG-CLNS, BPC, HGS, ALNS, AM, …)\n→ map local routes back to global tour", shape=box3d, fillcolor="#E8E8E8"];
            rc_out [label="context: tour (depot-separated),\ncost (km), extra_output, policy time", shape=parallelogram, fillcolor="#EDE7F6"];
            rc_key -> rc_q;
            rc_q -> rc_empty [label="yes"];
            rc_q -> rc_adapter [label="no"];
            rc_adapter -> rc_exec -> rc_out;
            rc_empty -> rc_out;
        }

        subgraph cluster_ri {
            label=<<B>RouteImprovementAction</B>>; style="filled,rounded"; fillcolor="#FBF9FD"; color="#8E6BB0";
            ri_q [label="len(tour) > 2 and\nroute_improvement configured ?", shape=diamond, fillcolor="#FFF3B0"];
            ri_run [label="for each processor from RouteImproverFactory\n(local search, 2-opt / Or-opt, LKH, ALNS-improve, …):\ntour = processor.improve(tour)", shape=hexagon, fillcolor="#FFE0B2"];
            ri_q -> ri_run [label="yes"];
        }

        subgraph cluster_tc {
            label=<<B>TimeConstraintAction</B>>; style="filled,rounded"; fillcolor="#FBF9FD"; color="#8E6BB0";
            tc_q [label="problem == ctop ?", shape=diamond, fillcolor="#FFF3B0"];
            tc_run [label="get_multi_tour(tour, time_matrix, shift_hours,\nservice_time, capacity) → split into\nshift-feasible depot-to-depot trips"];
            tc_q -> tc_run [label="yes"];
        }

        subgraph cluster_col {
            label=<<B>CollectAction</B>>; style="filled,rounded"; fillcolor="#FBF9FD"; color="#8E6BB0";
            col_norm [label="Normalise tour: ensure depot at both ends\nraw_km = route cost on distance_matrix\ntime_spent = driving time (time matrix or km / speed)\n+ n_bins × service_time"];
            col_q [label="problem == ctop ?", shape=diamond, fillcolor="#FFF3B0"];
            col_val [label="Validate each trip:\ntrip time ≤ shift_hours, load ≤ vehicle_capacity\n(AssertionError on violation)"];
            col_do [label="bins.collect(tour, raw_km)\ncollected kg = fill % × volume × density\nreset visited bins to 0, profit = kg·R − km·C"];
            col_out [label="context: cost, collected, total_collected,\nncol, profit, time_spent", shape=parallelogram, fillcolor="#EDE7F6"];
            col_norm -> col_q;
            col_q -> col_val [label="yes"];
            col_q -> col_do [label="no"];
            col_val -> col_do -> col_out;
        }

        subgraph cluster_log {
            label=<<B>LogAction</B>>; style="filled,rounded"; fillcolor="#FBF9FD"; color="#8E6BB0";
            log_res [label="get_daily_results(): cost, kg, overflows, lost,\nkg/km, reward = waste_w·kg − cost_w·km − overflow_penalty·overflows\n+ FailureAnalyzer summary"];
            log_out [label="Rich day table to console\nlog_realtime_<dist>_<N>N.jsonl (GUI stream)\nsim_tracker.log_day()", shape=cylinder, fillcolor="#DCEBF7"];
            log_res -> log_out;
        }

        pseed -> fill;
        fill_out -> sel_q;
        sel_skip -> rc_key; sel_out -> rc_key;
        rc_out -> ri_q;
        ri_q -> tc_q [label="no"]; ri_run -> tc_q;
        tc_q -> col_norm [label="no"]; tc_run -> col_norm;
        col_out -> log_res;
    }

    rundayref -> pseed [lhead=cluster_day, style=dashed, color="#8E6BB0", label="expands to"];

    // =====================================================================
    subgraph cluster_agg {
        label=<<B>5. Aggregation &amp; reporting</B>>; style="filled,rounded"; fillcolor="#F4F6F8"; color="#9AA5B1";
        agg [label="Per policy: mean / std over samples\n(output_stats when resuming, else statistics.mean/stdev)"];
        agg_json [label="update_policy_log_section(log_<policy>_<N>N.json, 'mean' / 'std')", shape=cylinder, fillcolor="#DCEBF7"];
        agg_gui [label="send_final_output_to_gui(realtime .jsonl)\ndisplay_log_metrics → Final Simulation Summary table\nrun.log_metric(sim/<policy>/<metric>)"];
        agg -> agg_json -> agg_gui;
    }

    collect_par -> agg [ltail=cluster_par];
    seq_loop -> agg [ltail=cluster_seq, label="all policies done"];
    agg_gui -> end;
    start -> cfg;
}
