// WSmart+ Route — PG-CLNS (Pheromone-Guided Cooperative Large Neighborhood Search) flowchart
// Source of truth: logic/src/policies/route_construction/meta_heuristics/pheromone_guided_cooperative_large_neighborhood_search/
// Render: dot -Tpdf pg_clns_flowchart.dot -o pg_clns_flowchart.pdf
digraph PGCLNS {
    graph [rankdir=TB, fontname="Helvetica", fontsize=11, labelloc=t, labeljust=l,
           label=<<B>PG-CLNS — Pheromone-Guided Cooperative Large Neighborhood Search</B><BR/><FONT POINT-SIZE="9">Population of ants (ACS construction) coached by an adaptive LNS with simulated-annealing acceptance; the best member deposits pheromone that guides the next generation. Objective: maximise profit = R·Σ collected waste − C·Σ distance, subject to vehicle capacity and mandatory-bin coverage.</FONT>>,
           nodesep=0.35, ranksep=0.45, compound=true, newrank=true, splines=spline, pad=0.3];
    node  [fontname="Helvetica", fontsize=9, shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#444444", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=8, color="#555555", arrowsize=0.7];

    start [label="START\nRouteConstructionAction → PGCLNSPolicy.execute(context)", shape=ellipse, style="filled", fillcolor="#2F4858", fontcolor="white"];
    end   [label="END\ntour · cost (km) · profit", shape=ellipse, style="filled", fillcolor="#2F4858", fontcolor="white"];

    // =====================================================================
    subgraph cluster_adapter {
        label=<<B>0. Policy adapter</B> — BaseRoutingPolicy / PGCLNSPolicy (registered as "pg_clns")>; style="filled,rounded"; fillcolor="#F4F6F8"; color="#9AA5B1";
        a_mand_q [label="mandatory bins\nempty (and not vrpp) ?", shape=diamond, fillcolor="#FFF3B0"];
        a_empty [label="return tour [0, 0], cost 0"];
        a_params [label="Load area params: capacity, R (revenue / kg scaled),\nC (cost / km) · merge PGCLNSConfig → PGCLNSParams\n(population_size=10, max_iterations=50, replacement_rate=0.2,\ntime_limit=60 s, aco.*, lns.*) · seed"];
        a_sub [label="Create sub-problem\nvrpp: all bins, mandatory = selected list\nelse: nodes = [depot] + mandatory only\nsub_dist_matrix, sub_wastes{local → fill %}", shape=cylinder, fillcolor="#DCEBF7"];
        a_solve [label="PGCLNSSolver(sub_dist, sub_wastes, capacity, R, C,\nparams, mandatory_nodes, seed).solve()", shape=box3d, fillcolor="#E8E8E8"];
        a_map [label="Map local routes → global ids\nflat tour: 0 r1… 0 r2… 0 · compute km on full matrix"];
        a_mand_q -> a_empty [label="yes"];
        a_mand_q -> a_params [label="no"];
        a_params -> a_sub -> a_solve -> a_map;
    }
    start -> a_mand_q;
    a_empty -> end;
    a_map -> end;

    // =====================================================================
    subgraph cluster_init {
        label=<<B>1. Solver initialisation</B> — PGCLNSSolver.__init__>; style="filled,rounded"; fillcolor="#EEF5EE"; color="#7FA87F";
        i_eta [label="Heuristic η(i,j) = 1 / d(i,j)"];
        i_tau0 [label="τ₀ = 1 / (n · nearest-neighbour tour cost)\n(or aco.tau_0 if given)"];
        i_pher [label="PheromoneTau: k-sparse matrix (k_sparse=15 per node),\nbounds [τ_min=0.001, τ_max=10], unseen edges = τ₀", shape=cylinder, fillcolor="#DCEBF7"];
        i_cand [label="Candidate lists: k nearest neighbours per node"];
        i_constr [label="SolutionConstructor (ACS ant, α=1, β=2, q₀, ρ=0.1)"];
        i_lns [label="LNSSolver 'coach'\ndestroy: random · worst · cluster removal\nrepair: greedy insertion · regret-2 insertion\nadaptive weights (all start at 1.0)"];
        i_eta -> i_tau0 -> i_pher -> i_cand -> i_constr -> i_lns;
    }
    a_solve -> i_eta [lhead=cluster_init, style=dashed, label="expands to"];

    // =====================================================================
    subgraph cluster_main {
        label=<<B>2. Main loop</B> — PGCLNSSolver.solve()>; style="filled,rounded"; fillcolor="#FFF8EC"; color="#D9A441";
        m_pop [label="for k in 1..population_size:\n  routes = constructor.construct()  (see 3.)\n  canonicalise (sort routes by first node)\n  cost = Σ route km · profit = R·Σ waste − C·cost", shape=hexagon, fillcolor="#FFE0B2"];
        m_best0 [label="best = argmax over population of\n(profit, −cost, route-hash)  [deterministic tie-break]"];
        m_iter [label="for iteration in 1..max_iterations:", shape=hexagon, fillcolor="#FFE0B2"];
        m_time_q [label="elapsed > time_limit ?", shape=diamond, fillcolor="#FFF3B0"];
        m_coach [label="COACHING — for every member:\n(routes, profit, cost) = coaching_solver.solve(initial=routes)  (see 4.)\ncanonicalise → new_population", shape=hexagon, fillcolor="#FFE0B2"];
        m_comp [label="GLOBAL COMPETITION\niter_best = argmax(new_population)"];
        m_best_q [label="iter_best.profit > best.profit ?", shape=diamond, fillcolor="#FFF3B0"];
        m_upd [label="best ← deepcopy(iter_best)"];
        m_pher [label="PHEROMONE UPDATE (ACS global rule)\nevaporate all stored edges: τ ← (1−ρ)·τ, floor τ_min\nΔ = elitist_weight / best.cost\ndeposit Δ on every arc of best routes (depot→r₀, rₖ→rₖ₊₁, r_last→depot),\nclamped to [τ_min, τ_max]"];
        m_viz [label="_viz_record(iteration, best_profit, best_cost,\niter_best_profit, population_size)", shape=parallelogram, fillcolor="#EDE7F6"];
        m_sort [label="REPLACEMENT\nsort population by (profit ↓, cost ↑, hash)\nn_replaced = ⌊population_size · replacement_rate⌋"];
        m_repl [label="for the n_replaced weakest members:\n  routes = constructor.construct()  (uses updated pheromones)\n  canonicalise, recompute cost & profit, overwrite slot", shape=hexagon, fillcolor="#FFE0B2"];
        m_ret [label="return best_routes, best_profit, best_cost"];

        m_pop -> m_best0 -> m_iter -> m_time_q;
        m_time_q -> m_ret [label="yes (break)"];
        m_time_q -> m_coach [label="no"];
        m_coach -> m_comp -> m_best_q;
        m_best_q -> m_upd [label="yes"];
        m_best_q -> m_pher [label="no"];
        m_upd -> m_pher -> m_viz -> m_sort -> m_repl;
        m_repl -> m_iter [style=dashed, label="next iteration"];
        m_iter -> m_ret [label="iterations exhausted"];
    }
    i_lns -> m_pop [ltail=cluster_init];
    m_ret -> a_map [style=dashed];

    // =====================================================================
    subgraph cluster_construct {
        label=<<B>3. Ant construction</B> — SolutionConstructor.construct() (ACS state-transition rule)>; style="filled,rounded"; fillcolor="#F3EEF8"; color="#8E6BB0";
        c_init [label="unvisited = all customer nodes\nmandatory_unvisited = mandatory set · routes = []"];
        c_outer_q [label="unvisited non-empty ?", shape=diamond, fillcolor="#FFF3B0"];
        c_prof_q [label="mandatory_unvisited empty and\nno node j with R·w_j > C·(d₀ⱼ + dⱼ₀) ?", shape=diamond, fillcolor="#FFF3B0"];
        c_new [label="open new route: route = [], load = 0, current = depot"];
        c_feas [label="feasible = { j ∈ unvisited : load + w_j ≤ capacity and\n( j mandatory  or  R·w_j > C·(d_cur,j + d_j,0 − d_cur,0) ) }"];
        c_feas_q [label="feasible empty ?", shape=diamond, fillcolor="#FFF3B0"];
        c_close [label="close route (return to depot), append to routes"];
        c_q0 [label="rand < q₀ ?", shape=diamond, fillcolor="#FFF3B0"];
        c_exploit [label="EXPLOIT: next = argmax_j τ(cur,j)^α · η(cur,j)^β"];
        c_explore [label="EXPLORE: pool = candidate-list ∩ feasible (else feasible)\nroulette-wheel on p_j ∝ τ(cur,j)^α · η(cur,j)^β"];
        c_local [label="ACS local update on arc (cur, next):\nτ ← (1−ρ)·τ + ρ·τ₀"];
        c_step [label="route += next · load += w_next\nunvisited −= next · mandatory_unvisited −= next · cur = next"];
        c_ret [label="return routes"];

        c_init -> c_outer_q;
        c_outer_q -> c_ret [label="no"];
        c_outer_q -> c_prof_q [label="yes"];
        c_prof_q -> c_ret [label="yes (nothing worth visiting)"];
        c_prof_q -> c_new [label="no"];
        c_new -> c_feas -> c_feas_q;
        c_feas_q -> c_close [label="yes"];
        c_close -> c_outer_q [style=dashed];
        c_feas_q -> c_q0 [label="no"];
        c_q0 -> c_exploit [label="yes"];
        c_q0 -> c_explore [label="no"];
        c_exploit -> c_local; c_explore -> c_local;
        c_local -> c_step;
        c_step -> c_feas [style=dashed, label="next node"];
    }
    m_pop -> c_init [lhead=cluster_construct, style=dashed, color="#8E6BB0", label="construct()"];
    m_repl -> c_init [lhead=cluster_construct, style=dashed, color="#8E6BB0"];

    // =====================================================================
    subgraph cluster_lns {
        label=<<B>4. Coaching session</B> — LNSSolver.solve(initial_solution) (Pisinger &amp; Ropke ALNS with SA acceptance)>; style="filled,rounded"; fillcolor="#EEF5EE"; color="#7FA87F";
        l_init [label="current = best = initial routes\nprofit = R·Σ waste − C·km · T = start_temp (100)"];
        l_iter [label="for it in 1..lns.max_iterations (5000):", shape=hexagon, fillcolor="#FFE0B2"];
        l_time_q [label="elapsed > lns.time_limit ?", shape=diamond, fillcolor="#FFF3B0"];
        l_select [label="roulette-wheel select destroy op d and repair op r\nfrom adaptive weights"];
        l_nrem [label="n_remove ~ U[ max(2,min_removal), max_removal_pct·|nodes| ]"];
        l_destroy [label="DESTROY: partial, removed = d(copy(current), n_remove)\nrandom / worst (highest detour) / cluster (spatially close)"];
        l_repair [label="REPAIR: new = r(partial, removed)\ngreedy cheapest insertion  or  regret-2 insertion\n(mandatory nodes always re-inserted; capacity respected)"];
        l_eval [label="new_profit = R·Σ waste(new) − C·km(new)"];
        l_acc_q [label="new_profit > current_profit\nor rand < exp(−(current−new)/T) ?", shape=diamond, fillcolor="#FFF3B0"];
        l_accept [label="current ← new"];
        l_best_q [label="new_profit > best_profit ?", shape=diamond, fillcolor="#FFF3B0"];
        l_best [label="best ← new · score = 3"];
        l_score1 [label="score = 1"];
        l_score0 [label="score = 0 (rejected)"];
        l_w [label="weight update (λ = 0.8):\nw_d ← λ·w_d + (1−λ)·max(0.1, score)\nw_r ← λ·w_r + (1−λ)·max(0.1, score)"];
        l_cool [label="T ← T · cooling_rate (0.995) · _viz_record(...)"];
        l_ret [label="return best_routes, best_profit, best_cost"];

        l_init -> l_iter -> l_time_q;
        l_time_q -> l_ret [label="yes (break)"];
        l_time_q -> l_select [label="no"];
        l_select -> l_nrem -> l_destroy -> l_repair -> l_eval -> l_acc_q;
        l_acc_q -> l_accept [label="yes"];
        l_acc_q -> l_score0 [label="no"];
        l_accept -> l_best_q;
        l_best_q -> l_best [label="yes"];
        l_best_q -> l_score1 [label="no"];
        l_best -> l_w; l_score1 -> l_w; l_score0 -> l_w;
        l_w -> l_cool;
        l_cool -> l_iter [style=dashed, label="next"];
        l_iter -> l_ret [label="exhausted"];
    }
    m_coach -> l_init [lhead=cluster_lns, style=dashed, color="#7FA87F", label="per member"];
}
