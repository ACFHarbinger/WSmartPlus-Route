// WSmart+ Route — SWC-TCF (Smart Waste Collection Two-Commodity Flow) exact MILP flowchart
// Source of truth: logic/src/policies/route_construction/exact_and_decomposition_solvers/smart_waste_collection_two_commodity_flow/
// Render: dot -Tpdf swc_tcf_flowchart.dot -o swc_tcf_flowchart.pdf
digraph SWCTCF {
    graph [rankdir=TB, fontname="Helvetica", fontsize=11, labelloc=t, labeljust=l,
           label=<<B>SWC-TCF — Smart Waste Collection Two-Commodity Flow exact model</B><BR/><FONT POINT-SIZE="9">Compact arc-based MILP: binary arcs x_ij, visit indicators g_i, fleet size k, and two continuous commodities per arc (f = waste on board, h = residual capacity) whose sum equals Q·x_ij. Flow balance enforces capacity and eliminates subtours without exponential cut families. Solved by Gurobi / SCIP / HiGHS / CPLEX through OR-Tools, Pyomo or native gurobipy.</FONT>>,
           nodesep=0.35, ranksep=0.45, compound=true, newrank=true, splines=spline, pad=0.3];
    node  [fontname="Helvetica", fontsize=9, shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#444444", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=8, color="#555555", arrowsize=0.7];

    start [label="START\nRouteConstructionAction → SWCTCFPolicy.execute(context)", shape=ellipse, style="filled", fillcolor="#2F4858", fontcolor="white"];
    end   [label="END\ntour · profit · km", shape=ellipse, style="filled", fillcolor="#2F4858", fontcolor="white"];

    subgraph cluster_adapter {
        label=<<B>0. Policy adapter</B> — SWCTCFPolicy (registered as "swc_tcf")>; style="filled,rounded"; fillcolor="#F4F6F8"; color="#9AA5B1";
        a_q [label="mandatory bins empty\n(and not vrpp) ?", shape=diamond, fillcolor="#FFF3B0"];
        a_empty [label="return tour [0, 0]"];
        a_params [label="Load Q (capacity, % points), R (€ per % fill), C (€ / km)\nsub-problem (all bins if vrpp) · SWCTCFParams: framework 'ortools',\nengine 'gurobi', time_limit 60 s, seed · config: Omega, delta, psi"];
        a_arrays [label="amounts[i−1] = fill % of local bin i · binsids = 1..n\nvalues = {…config, Q, R, C}", shape=cylinder, fillcolor="#DCEBF7"];
        a_run [label="run_swc_tcf_optimizer(bins, dist, values, binsids, mandatory,\nnumber_vehicles, time_limit, framework, optimizer, seed, dual_values)", shape=box3d, fillcolor="#E8E8E8"];
        a_clean [label="strip depot zeros from raw route → [[bins…]]\nmap local ids → global tour · km on full matrix"];
        a_q -> a_empty [label="yes"]; a_q -> a_params [label="no"];
        a_params -> a_arrays -> a_run -> a_clean;
    }
    start -> a_q; a_empty -> end; a_clean -> end;

    subgraph cluster_dispatch {
        label=<<B>1. Backend dispatch</B> — run_swc_tcf_optimizer()>; style="filled,rounded"; fillcolor="#EEF5EE"; color="#7FA87F";
        d_q [label="framework ?", shape=diamond, fillcolor="#FFF3B0"];
        d_ort [label="OR-Tools pywraplp.Solver.CreateSolver(GUROBI | SCIP | HIGHS | CPLEX)\nsame TCF model built with BoolVar / NumVar / IntVar\nSetTimeLimit(ms) · Solve()"];
        d_ort_q [label="backend GUROBI and result\nis the empty [0,0] / 0.0 ?", shape=diamond, fillcolor="#FFF3B0"];
        d_pyomo [label="Pyomo ConcreteModel with gurobi | scip | appsi_highs\n(same TCF constraints)", fillcolor="#E8E8E8"];
        d_native [label="_run_gurobi_optimizer() — native gurobipy  (see 2.)", shape=box3d, fillcolor="#E8E8E8"];
        d_err [label="ValueError: unknown framework / backend", fillcolor="#FDE2E2"];
        d_q -> d_ort [label="ortools (default)"];
        d_q -> d_pyomo [label="pyomo"];
        d_q -> d_native [label="gurobi / native"];
        d_q -> d_err [label="other"];
        d_ort -> d_ort_q;
        d_ort_q -> d_native [label="yes (fallback)"];
    }
    a_run -> d_q [lhead=cluster_dispatch, style=dashed, label="expands to"];
    d_ort_q -> a_clean [label="no", style=dashed];
    d_pyomo -> a_clean [style=dashed];

    subgraph cluster_model {
        label=<<B>2. MILP construction</B> — _run_gurobi_optimizer(bins, dist, env, values, binsids, mandatory, K, time_limit, seed, duals)>; style="filled,rounded"; fillcolor="#FFF8EC"; color="#D9A441";
        m_sets [label="nodes N = {0 (depot), 1..n} · S_i = fill % of node i (S₀ = 0)\ncritical_i = (bin i ∈ mandatory)\nfeasible arcs A = {(i, j): i ≠ j, d_ij ≤ 6 000 km}"];
        m_vars [label="VARIABLES\nx_ij ∈ {0,1} arc used · g_i ∈ {0,1} node visited\nf_ij ≥ 0 waste flowing on arc · h_ij ≥ 0 empty capacity flowing on arc\nk ∈ ℤ₊ number of vehicles used"];
        m_c1 [label="(1) Arc capacity coupling:   f_ij + h_ij = Q · x_ij   ∀(i,j) ∈ A"];
        m_c2 [label="(2) Waste balance at node i ≠ 0:   Σ_j f_ij − Σ_j f_ji = S_i · g_i\n(3) Empty-capacity balance:        Σ_j h_ji − Σ_j h_ij = S_i · g_i"];
        m_c3 [label="(4) Depot: Σ_i f_i0 = Σ_i S_i·g_i  (all waste returns)\n      Σ_j h_0j = Q · k  (trucks leave empty)\n      Σ_j f_0j = 0  (no waste leaves depot)"];
        m_c4 [label="(5) Fleet: k ≤ K (K = n if 0) · Σ_j x_0j = k · Σ_j x_j0 = k\n      x_0j ≤ g_j, x_j0 ≤ g_j"];
        m_c5 [label="(6) Mandatory coverage: Σ_{i critical} g_i ≥ #critical − n·delta\n      g_i = 1 if critical_i or S_i ≥ psi · 100  (near-full bins forced)"];
        m_c6 [label="(7) Degree: Σ_i x_ij = g_j and Σ_k x_jk = g_j   ∀ j ≠ 0\n(subtour elimination and capacity are implied by the two-commodity flows)"];
        m_obj_q [label="dual_values given\n(pricing mode) ?", shape=diamond, fillcolor="#FFF3B0"];
        m_obj_std [label="OBJECTIVE (standard):  max  R·Σ S_i·g_i  −  ½·C·Σ d_ij·x_ij  −  Omega·k"];
        m_obj_dual [label="OBJECTIVE (reduced cost):  max  Σ (R·S_i − π_i)·g_i  −  ½·C·Σ d_ij·x_ij  −  π₀·k"];
        m_params [label="Gurobi params (no shared env): MIPFocus 1, Heuristics 0.5, Cuts 3,\nClique/Cover/FlowCover/GUBCover cuts 2, Presolve 1,\nNodefileStart 0.5 GB, MIPGap 1 %, Seed, TimeLimit"];
        m_opt [label="mdl.optimize()  (Gurobi branch-and-cut)", shape=box3d, fillcolor="#E8E8E8"];
        m_sets -> m_vars -> m_c1 -> m_c2 -> m_c3 -> m_c4 -> m_c5 -> m_c6 -> m_obj_q;
        m_obj_q -> m_obj_dual [label="yes"]; m_obj_q -> m_obj_std [label="no"];
        m_obj_dual -> m_params; m_obj_std -> m_params;
        m_params -> m_opt;
    }
    d_native -> m_sets [lhead=cluster_model, style=dashed, label="expands to"];

    subgraph cluster_extract {
        label=<<B>3. Solution extraction</B>>; style="filled,rounded"; fillcolor="#F3EEF8"; color="#8E6BB0";
        e_q [label="SolCount > 0 ?", shape=diamond, fillcolor="#FFF3B0"];
        e_arcs [label="active arcs = {(i,j): x_ij > 0.5}"];
        e_walk [label="walk from depot following unused active arcs\nuntil back at 0 → one route; repeat while a route was found", shape=hexagon, fillcolor="#FFE0B2"];
        e_out [label="collected = concatenated node ids of all routes (local → binsids)\nprofit = ObjVal · cost = Σ x_ij · d_ij"];
        e_none [label="no solution: route [0], profit 0, cost 0", fillcolor="#FDE2E2"];
        e_ret [label="return [0] + collected, profit, cost"];
        e_q -> e_arcs [label="yes"]; e_q -> e_none [label="no"];
        e_arcs -> e_walk -> e_out -> e_ret; e_none -> e_ret;
    }
    m_opt -> e_q [lhead=cluster_extract];
    e_ret -> a_clean [style=dashed];
}
