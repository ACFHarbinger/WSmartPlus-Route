// WSmart+ Route — Branch-and-Price-and-Cut (BPC) exact solver flowchart
// Source of truth:
//   logic/src/policies/route_construction/exact_and_decomposition_solvers/branch_and_price_and_cut/{policy_bpc.py,bpc_engine.py,params.py}
//   logic/src/policies/helpers/solvers_and_matheuristics/{search/column_generation.py,pricing/solver.py,pricing/smoothing.py,branching/*,search/cutting_planes.py}
// Render: dot -Tpdf bpc_flowchart.dot -o bpc_flowchart.pdf
digraph BPC {
    graph [rankdir=TB, fontname="Helvetica", fontsize=11, labelloc=t, labeljust=l,
           label=<<B>Branch-and-Price-and-Cut for the VRPP (Barnhart, Hane &amp; Vance 2000 framework)</B><BR/><FONT POINT-SIZE="9">Set-partitioning master over route columns λ_k · RCSPP pricing with ng-route relaxation · lifted-cover / RCC / SRI cuts · hierarchical branching · DFS with LP-basis warm start. Objective: maximise profit = Σ_k (R·waste_k − C·dist_k)·λ_k</FONT>>,
           nodesep=0.3, ranksep=0.4, compound=true, newrank=true, splines=spline, pad=0.3];
    node  [fontname="Helvetica", fontsize=9, shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#444444", margin="0.12,0.06"];
    edge  [fontname="Helvetica", fontsize=8, color="#555555", arrowsize=0.7];

    start [label="START\nRouteConstructionAction → BPCPolicy.execute(context)", shape=ellipse, style="filled", fillcolor="#2F4858", fontcolor="white"];
    end   [label="END\nroutes · profit · km", shape=ellipse, style="filled", fillcolor="#2F4858", fontcolor="white"];

    // =====================================================================
    subgraph cluster_adapter {
        label=<<B>0. Policy adapter</B> — BPCPolicy (registered as "bpc")>; style="filled,rounded"; fillcolor="#F4F6F8"; color="#9AA5B1";
        a_sub [label="BaseRoutingPolicy: load capacity, R, C · BPCConfig → params\nsub-problem: vrpp=True → all bins, mandatory = selected list\nvehicle_limit = n_vehicles (or None)", shape=cylinder, fillcolor="#DCEBF7"];
        a_run [label="run_bpc(sub_dist, sub_wastes, capacity, R, C, params,\nmandatory_indices, vehicle_limit, env)", shape=box3d, fillcolor="#E8E8E8"];
        a_map [label="profit = Σ_routes (R·waste − C·km) · map to global tour"];
        a_sub -> a_run -> a_map;
    }
    start -> a_sub; a_map -> end;

    // =====================================================================
    subgraph cluster_setup {
        label=<<B>1. Engine set-up</B> — run_bpc()>; style="filled,rounded"; fillcolor="#EEF5EE"; color="#7FA87F";
        s_params [label="BPCParams (defaults): time_limit 60 s · max_bb_nodes 1000 · max_cg_iterations 50\nmax_cuts/iter 5 · max_routes/pricing 5 · optimality_gap 1e-4 · early_termination_gap 1e-3\nsearch depth_first · branching divergence · cuts saturated_arc_lci · ng size 8 · rcspp_timeout 30 s\nwarn if rc_tolerance > optimality_gap"];
        s_master [label="VRPPMasterProblem (Gurobi LP)\nmax Σ profit_k·λ_k  s.t. Σ_k a_ik·λ_k = 1 (mandatory) / ≤ 1 (optional),\nΣ λ_k ≤ vehicle_limit · 0 ≤ λ_k ≤ 1\nstrict set partitioning if branching = ryan_foster"];
        s_init [label="Initial columns: greedy (or profit-aware greedy) insertion\nover mandatory nodes → warm-start routes\n+ optional-node seed routes with profit > 0 (profit_aware_operators)"];
        s_pricer [label="RCSPPSolver(n, dist, wastes, capacity, R, C,\nng-route relaxation, ng size, timeout, max_labels)"];
        s_build [label="master.build_model(initial_columns) · column deletion on\nPhase 1 (feasibility) if mandatory nodes exist, else Phase 2 (profit)"];
        s_cuts [label="VRPPModel + SeparationEngine (heuristic RCC, comb cuts)\ncut engine = create_cutting_plane_engine(saturated_arc_lci | rcc | sri | lci | …)\n+ always-on supplemental engines: MinCut, TriangleClique,\nLimitedMemoryRank1, NodeProfitBound, PathElimination → Composite"];
        s_tree [label="BranchAndBoundTree(search = depth_first | best_first | hybrid,\nstrategy = divergence | ryan_foster | edge | …) · root node"];
        s_params -> s_master -> s_init -> s_pricer -> s_build -> s_cuts -> s_tree;
    }
    a_run -> s_params [lhead=cluster_setup, style=dashed, label="expands to"];

    // =====================================================================
    subgraph cluster_bb {
        label=<<B>2. Branch-and-bound loop</B>>; style="filled,rounded"; fillcolor="#FFF8EC"; color="#D9A441";
        b_loop [label="while tree not empty and nodes_explored < max_bb_nodes:", shape=hexagon, fillcolor="#FFE0B2"];
        b_time_q [label="elapsed > time_limit ?", shape=diamond, fillcolor="#FFF3B0"];
        b_pop [label="node = tree.get_next_node()  (DFS: deepest / last pushed)\nnodes_explored += 1 · master.remove_local_cuts()"];
        b_apply [label="constraints = node.get_all_constraints() (root → node)\napply_branching_to_master: reset λ upper bounds to 1,\nset λ_k = 0 for columns violating any constraint;\npass forbidden / required arcs to pricing"];
        b_lr_q [label="lr_pre_pruning and incumbent exists\nand depth ≤ lr depth limit ?", shape=diamond, fillcolor="#FFF3B0"];
        b_lr [label="Lagrangian pre-pruning: subgradient bound on\n(forced-in ∪ mandatory, forced-out) with ≤ 5 % of remaining time"];
        b_lr_q2 [label="LR bound ≤ incumbent·(1+gap) ?", shape=diamond, fillcolor="#FFF3B0"];
        b_lr_prune [label="prune node without CG\n(optionally seed LR route as column)", fillcolor="#FDE2E2"];
        b_ng [label="snapshot ng-neighbourhoods\nnode budget = remaining time (root: ≤ 40 % of time_limit)"];
        b_arcfix [label="Reduced-cost arc fixing (Irnich 2010):\nforbid arcs whose min reduced cost > parent LP − incumbent"];
        b_cg [label="lp_obj, λ, basis, timed_out =\ncolumn_generation_loop(master, pricer, cut_engine, constraints, …)\n(see 3.)", shape=box3d, fillcolor="#E8E8E8"];
        b_restore [label="restore ng snapshot (siblings unaffected)"];
        b_exc [label="BPCPruningException → skip node\nGurobiError / RuntimeError (LP infeasible,\nconflicting must-use arcs) → node infeasible", fillcolor="#FDE2E2"];
        b_to_q [label="node timed out ?", shape=diamond, fillcolor="#FFF3B0"];
        b_store [label="node.lp_bound = lp_obj · node.route_values = λ · node.lp_basis = basis"];
        b_gap_q [label="incumbent exists and\n(max(open bounds, lp_obj) − incumbent) / denom ≤ optimality_gap ?", shape=diamond, fillcolor="#FFF3B0"];
        b_edgefix [label="Reduced-cost edge fixing with global UB / incumbent LB"];
        b_int_q [label="λ integral\n(all λ_k ∈ {0,1}) ?", shape=diamond, fillcolor="#FFF3B0"];
        b_inc [label="update incumbent (best integer node)\ntree.prune_by_bound()"];
        b_bound_q [label="incumbent exists and\nlp_obj ≤ incumbent ?", shape=diamond, fillcolor="#FFF3B0"];
        b_prune [label="prune by bound", fillcolor="#FDE2E2"];
        b_dedup [label="deduplicate column pool (optional)\nstrong branching on ≤ 5 candidates (optional)"];
        b_branch [label="BRANCH (see 4.) → (left_child, right_child)", shape=box3d, fillcolor="#E8E8E8"];
        b_order [label="Push children:\ndivergence + DFS → right child (shorter path kept) popped first\nelse child with higher LP hint first; tie → fewer local constraints first"];
        b_end [label="Search finished"];

        b_loop -> b_time_q;
        b_time_q -> b_end [label="yes"];
        b_time_q -> b_pop [label="no"];
        b_pop -> b_apply -> b_lr_q;
        b_lr_q -> b_lr [label="yes"];
        b_lr_q -> b_ng [label="no"];
        b_lr -> b_lr_q2;
        b_lr_q2 -> b_lr_prune [label="yes"];
        b_lr_q2 -> b_ng [label="no"];
        b_lr_prune -> b_loop [style=dashed];
        b_ng -> b_arcfix -> b_cg -> b_restore -> b_to_q;
        b_cg -> b_exc [style=dashed, color="#B03A2E"];
        b_exc -> b_loop [style=dashed];
        b_to_q -> b_end [label="yes (terminate)"];
        b_to_q -> b_store [label="no"];
        b_store -> b_gap_q;
        b_gap_q -> b_end [label="yes"];
        b_gap_q -> b_edgefix [label="no"];
        b_edgefix -> b_int_q;
        b_int_q -> b_inc [label="yes"];
        b_inc -> b_loop [style=dashed];
        b_int_q -> b_bound_q [label="no"];
        b_bound_q -> b_prune [label="yes"];
        b_prune -> b_loop [style=dashed];
        b_bound_q -> b_dedup [label="no"];
        b_dedup -> b_branch -> b_order;
        b_order -> b_loop [style=dashed, label="next node"];
        b_loop -> b_end [label="tree empty / node cap"];
    }
    s_tree -> b_loop [ltail=cluster_setup];

    // =====================================================================
    subgraph cluster_extract {
        label=<<B>5. Solution extraction</B>>; style="filled,rounded"; fillcolor="#F4F6F8"; color="#9AA5B1";
        e_q [label="integer incumbent found ?", shape=diamond, fillcolor="#FFF3B0"];
        e_best [label="routes = columns with λ_k > 0.5 at best node\nobjective = Σ profit_k · recorder.record(exact_bpc)"];
        e_fb [label="fallback: mandatory-only greedy routes\n+ their profit", fillcolor="#FDE2E2"];
        e_q -> e_best [label="yes"];
        e_q -> e_fb [label="no"];
    }
    b_end -> e_q;
    e_best -> a_map [style=dashed]; e_fb -> a_map [style=dashed];

    // =====================================================================
    subgraph cluster_cg {
        label=<<B>3. Column generation + cutting planes at a node</B> — column_generation_loop()>; style="filled,rounded"; fillcolor="#F3EEF8"; color="#8E6BB0";
        g_elem [label="Enforce strict elementarity in pricing for nodes in\nRyan-Foster pairs, forced node-visits and active SRI subsets\ncheck for conflicting must-use arcs"];
        g_outer [label="for cg_iter in 1..max_cg_iterations:", shape=hexagon, fillcolor="#FFE0B2"];
        g_inner [label="inner pricing loop:", shape=hexagon, fillcolor="#FFE0B2"];
        g_basis [label="first pass: restore parent LP basis (warm start)\nlater passes: sift global column pool → re-activate positive-RC columns,\nre-apply branching bounds"];
        g_lp [label="Solve RMP LP (Gurobi, remaining time budget)"];
        g_status_q [label="LP status ?", shape=diamond, fillcolor="#FFF3B0"];
        g_farkas [label="PHASE I — Farkas pricing:\nprice with Farkas dual ray → add columns restoring feasibility\n(3 consecutive RCSPP timeouts → abort CG;\nno column → RuntimeError: node infeasible)"];
        g_phase [label="Phase 1 → Phase 2 once LP optimal\n(route objectives switch 0 → profit)"];
        g_root_q [label="cg_at_root_only\nand depth > 0 ?", shape=diamond, fillcolor="#FFF3B0"];
        g_duals [label="Duals from master: node π_i, RCC, SRI (Jepsen 2008),\nLCI γ_lm + node α (Gu et al. 1995), clique, multistar\n[Wentges dual smoothing unless exact_mode]"];
        g_price [label="PHASE II — solve_pricing_step:\nroutes = RCSPP.solve(duals, constraints, max_routes ≥ 50)  (see 3b.)\nadd routes with reduced cost > rc_tolerance"];
        g_to_q [label="pricer timed out 3× in a row ?", shape=diamond, fillcolor="#FFF3B0"];
        g_added_q [label="columns added ?", shape=diamond, fillcolor="#FFF3B0"];
        g_smooth_q [label="dual smoothing active ?", shape=diamond, fillcolor="#FFF3B0"];
        g_recover [label="enter smoothing-recovery: disable smoothing,\nre-price with exact duals"];
        g_cycle_q [label="fractional columns with\nng-cycles (repeated node) ?", shape=diamond, fillcolor="#FFF3B0"];
        g_ngexp [label="expand ng-neighbourhoods on cycle nodes,\npurge cyclic columns (λ = 0) → re-solve"];
        g_conv [label="pricing converged for this cut round"];
        g_lag [label="Lagrangian bound z_UB = RMP + fleet · max(0, max_rc)"];
        g_lag_q [label="z_UB < incumbent ?", shape=diamond, fillcolor="#FFF3B0"];
        g_lag_prune [label="raise BPCPruningException\n(node cannot improve incumbent)", fillcolor="#FDE2E2"];
        g_early_q [label="(z_UB − incumbent)/|incumbent|\n≤ early_termination_gap ?", shape=diamond, fillcolor="#FFF3B0"];
        g_sep [label="SEPARATE CUTS: cut_engine.separate_and_add_cuts(λ, max_cuts,\northogonality ≤ 0.8): saturated-arc LCI, RCC, SRI, LM-rank-1,\nmin-cut, triangle clique, node-profit bound, path elimination"];
        g_cuts_q [label="cuts added ?", shape=diamond, fillcolor="#FFF3B0"];
        g_delta_q [label="|Δ obj| / |obj| < 1e-5\n(tailing off) ?", shape=diamond, fillcolor="#FFF3B0"];
        g_ret [label="return obj_val, λ, final basis, timed_out"];

        g_elem -> g_outer -> g_inner -> g_basis -> g_lp -> g_status_q;
        g_status_q -> g_farkas [label="infeasible"];
        g_farkas -> g_inner [style=dashed, label="re-solve"];
        g_status_q -> g_phase [label="optimal"];
        g_phase -> g_root_q;
        g_root_q -> g_conv [label="yes"];
        g_root_q -> g_duals [label="no"];
        g_duals -> g_price -> g_to_q;
        g_to_q -> g_conv [label="yes (abort)"];
        g_to_q -> g_added_q [label="no"];
        g_added_q -> g_inner [label="yes", style=dashed];
        g_added_q -> g_smooth_q [label="no"];
        g_smooth_q -> g_recover [label="yes"];
        g_recover -> g_inner [style=dashed];
        g_smooth_q -> g_cycle_q [label="no"];
        g_cycle_q -> g_ngexp [label="yes"];
        g_ngexp -> g_inner [style=dashed];
        g_cycle_q -> g_conv [label="no"];
        g_conv -> g_lag -> g_lag_q;
        g_lag_q -> g_lag_prune [label="yes"];
        g_lag_q -> g_early_q [label="no"];
        g_early_q -> g_ret [label="yes"];
        g_early_q -> g_sep [label="no"];
        g_sep -> g_cuts_q;
        g_cuts_q -> g_ret [label="no (converged)"];
        g_cuts_q -> g_delta_q [label="yes"];
        g_delta_q -> g_ret [label="yes"];
        g_delta_q -> g_outer [label="no", style=dashed];
        g_outer -> g_ret [label="cap reached"];
    }
    b_cg -> g_elem [lhead=cluster_cg, style=dashed, color="#8E6BB0", label="expands to"];

    // =====================================================================
    subgraph cluster_rcspp {
        label=<<B>3b. Pricing sub-problem</B> — RCSPPSolver.solve(): elementary/ng shortest path with resource (load) constraint>; style="filled,rounded"; fillcolor="#FBF9FD"; color="#8E6BB0";
        p_rc [label="node reduced prize: r_i = R·w_i − π_i (Phase II) or Farkas ray (Phase I)\npre-process constraints → forbidden arcs, required succ/pred,\nRyan-Foster separate / together · completion bounds"];
        p_heur_q [label="n > 40 ?", shape=diamond, fillcolor="#FFF3B0"];
        p_heur [label="heuristic pricing (restricted neighbourhoods)"];
        p_enough_q [label="≥ max_routes / 2\nheuristic columns ?", shape=diamond, fillcolor="#FFF3B0"];
        p_dp [label="LABEL-CORRECTING DP\nmax-heap on reduced cost, start at depot (rc 0, load 0)"];
        p_ext [label="extend label u → v for v in k nearest neighbours (all if exact_mode):\nskip fixed / forbidden arcs, visited, ng-memory, RF separation,\nwrong required predecessor · load + w_v ≤ capacity\nrc += r_v − C·d_uv − Σ cut duals (RCC, SRI state, LCI α, clique)"];
        p_dom [label="dominance: drop label if an existing label at v dominates\n(rc, load, ng-set, SRI state); remove labels it dominates"];
        p_depot [label="extend u → depot when allowed\ncompletion-bound pruning → candidate Route(nodes, profit, rc)"];
        p_stop_q [label="labels > n^1.5·200 cap\nor timeout ?", shape=diamond, fillcolor="#FFF3B0"];
        p_partial [label="set _timed_out, return partial results"];
        p_ret [label="return top max_routes routes by reduced cost\nlast_max_rc recorded (DSSR wrapper if enable_dssr)"];
        p_rc -> p_heur_q;
        p_heur_q -> p_heur [label="yes"];
        p_heur_q -> p_dp [label="no"];
        p_heur -> p_enough_q;
        p_enough_q -> p_ret [label="yes"];
        p_enough_q -> p_dp [label="no"];
        p_dp -> p_ext -> p_dom -> p_depot -> p_stop_q;
        p_stop_q -> p_partial [label="yes"];
        p_stop_q -> p_ext [label="no (heap non-empty)", style=dashed];
        p_stop_q -> p_ret [label="heap empty"];
        p_partial -> p_ret;
    }
    g_price -> p_rc [lhead=cluster_rcspp, style=dashed, color="#8E6BB0"];
    g_farkas -> p_rc [lhead=cluster_rcspp, style=dashed, color="#8E6BB0"];

    // =====================================================================
    subgraph cluster_branch {
        label=<<B>4. Branching hierarchy</B> — fractional LP solution>; style="filled,rounded"; fillcolor="#EEF5EE"; color="#7FA87F";
        r_y_q [label="optional nodes exist and\nenable_node_visitation_branching ?", shape=diamond, fillcolor="#FFF3B0"];
        r_y [label="HierarchicalStrongBranching.find_best_y_branching:\nmost fractional y_v = Σ_k a_vk·λ_k (optional node),\n2-phase strong branching if enabled"];
        r_y_found_q [label="candidate found ?", shape=diamond, fillcolor="#FFF3B0"];
        r_y_children [label="children: y_v = 0 (never visit) | y_v = 1 (must visit)"];
        r_strong_q [label="strong-branching\ncandidate ?", shape=diamond, fillcolor="#FFF3B0"];
        r_fleet [label="FleetSizeBranching: Σλ fractional → ⌊Σλ⌋ | ⌈Σλ⌉"];
        r_div [label="Divergence branching (BHV2000 §4.3): trace two highest-λ routes\nfrom depot, first divergence node d → arc_set_1 (shorter path arc)\nvs arc_set_2 (other outgoing arcs); child forbids one set"];
        r_rf [label="Ryan-Foster: node pair (i,j) with 0 < Σ_k a_ik a_jk λ_k < 1\n→ together | separate (master hardened to strict SP)"];
        r_edge [label="Edge branching: most fractional arc flow x_uv → x_uv = 0 | 1"];
        r_node [label="NodeVisitationBranching on fractional mandatory node"];
        r_none [label="no candidate → skip node", fillcolor="#FDE2E2"];
        r_out [label="children (left, right) with lp_bound hint"];

        r_y_q -> r_y [label="yes"];
        r_y -> r_y_found_q;
        r_y_found_q -> r_y_children [label="yes"];
        r_y_children -> r_out;
        r_y_found_q -> r_strong_q [label="no"];
        r_y_q -> r_strong_q [label="no"];
        r_strong_q -> r_out [label="yes: use its partition"];
        r_strong_q -> r_fleet [label="no"];
        r_fleet -> r_div [label="not fractional"];
        r_fleet -> r_out [label="found"];
        r_div -> r_rf [label="no divergence"];
        r_div -> r_out [label="found"];
        r_rf -> r_edge [label="none"];
        r_rf -> r_out [label="found"];
        r_edge -> r_node [label="none"];
        r_edge -> r_out [label="found"];
        r_node -> r_out [label="found"];
        r_node -> r_none [label="none"];
    }
    b_branch -> r_y_q [lhead=cluster_branch, style=dashed, color="#7FA87F", label="expands to"];
}
